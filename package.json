{
  "name": "scree-core",
  "version": "0.1.0",
  "type": "module",
  "description": "Every piece finds its place. Turn a screenshot, logo, photo, word, or 3D model into the next one, with every piece traveling to its match.",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:types && npm run build:playground",
    "build:lib": "vite build --config vite.library.config.ts",
    "build:types": "tsc -p tsconfig.library.json",
    "build:playground": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "pack:check": "npm pack --dry-run"
  },
  "main": "./dist/scree.js",
  "module": "./dist/scree.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/scree.js"
    }
  },
  "files": [
    "dist/scree.js",
    "dist/types",
    "README.md"
  ],
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vitest": "^3.0.9"
  }
}
