{
  "name": "scree-core",
  "version": "0.2.1",
  "type": "module",
  "description": "Every piece finds its place. A WebGL engine that breaks any picture into pieces and settles every piece where it belongs in the next — twenty transitions, real pixels, exact MP4 export.",
  "keywords": [
    "webgl",
    "three",
    "transition",
    "image-transition",
    "morph",
    "shatter",
    "particles",
    "animation",
    "scroll",
    "creative-coding"
  ],
  "license": "MIT",
  "homepage": "https://scree-tau.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imshivamb/Scree.git"
  },
  "bugs": {
    "url": "https://github.com/imshivamb/Scree/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:types && npm run build:playground",
    "build:lib": "vite build --config vite.library.config.ts",
    "build:types": "tsc -p tsconfig.library.json",
    "build:playground": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "pack:check": "npm pack --dry-run",
    "check:effects": "node scripts/check-effects.mjs",
    "build:react": "node scripts/build-react.mjs",
    "prepublishOnly": "npm test && npm run build:lib && npm run build:types"
  },
  "main": "./dist/scree.js",
  "module": "./dist/scree.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/scree.js"
    }
  },
  "files": [
    "dist/scree.js",
    "dist/types",
    "README.md"
  ],
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.170.0",
    "@vercel/analytics": "^2.0.1",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vitest": "^3.0.9"
  },
  "sideEffects": true
}
